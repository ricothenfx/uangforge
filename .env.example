# LLM endpoint (any OpenAI-compatible API). Optional — without it, the three
# sample contracts still work with their precomputed analyses.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Public site URL (used for metadata/sitemap). Optional in dev.
NEXT_PUBLIC_SITE_URL=
