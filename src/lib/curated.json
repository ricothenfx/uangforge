[
 {
  "appName": "Leave Tracker",
  "tagline": "Track time-off requests with approval",
  "prompt": "an app to track employee leave requests with manager approval",
  "source": "curated",
  "entities": [
   {
    "name": "request",
    "namePlural": "requests",
    "fields": [
     {
      "name": "employee",
      "type": "text",
      "required": true
     },
     {
      "name": "type",
      "type": "select",
      "required": true,
      "options": [
       "annual",
       "sick",
       "unpaid"
      ]
     },
     {
      "name": "days",
      "type": "number",
      "required": true
     },
     {
      "name": "status",
      "type": "select",
      "required": true,
      "options": [
       "pending",
       "approved",
       "rejected",
       "canceled"
      ]
     }
    ],
    "statusField": "status",
    "statusValues": [
     "pending",
     "approved",
     "rejected",
     "canceled"
    ]
   },
   {
    "name": "employee",
    "namePlural": "employees",
    "fields": [
     {
      "name": "name",
      "type": "text",
      "required": true
     },
     {
      "name": "department",
      "type": "text",
      "required": true
     },
     {
      "name": "email",
      "type": "text",
      "required": true
     }
    ]
   }
  ],
  "views": [
   {
    "entity": "request",
    "type": "table"
   },
   {
    "entity": "request",
    "type": "board"
   }
  ],
  "dashboard": [
   {
    "label": "Pending requests",
    "entity": "request",
    "field": "status",
    "agg": "count"
   },
   {
    "label": "Total days requested",
    "entity": "request",
    "field": "days",
    "agg": "sum"
   }
  ],
  "workflow": {
   "name": "Approve leave",
   "entity": "request",
   "fromStatus": "pending",
   "toStatus": "approved",
   "requiresApproval": true
  }
 },
